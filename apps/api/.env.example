# ── Copy this to .env and fill in your values ─────────────────────────────────

# App
APP_NAME="DBS Architectes API"
DEBUG=true
ENVIRONMENT=development

# Security — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dbs:dbs_secret@localhost:5432/dbs_architectes

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=dbs-architectes-assets

# CORS — add your frontend URLs
# monday.com import
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_REQUEST_TIMEOUT_SECONDS=30
MONDAY_DEFAULT_PAGE_SIZE=100

ALLOWED_ORIGINS=["http://localhost:3000","https://dbs-architectes-manish.vercel.app"]
