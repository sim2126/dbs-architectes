# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
*.db

# locally-stored chat uploads (production uses S3)
#
# Everything directly under uploads/ is a real user upload and stays out of
# git. demo/ is the exception: those are generated demo fixtures committed on
# purpose, because the seeded attachment rows point at these paths and a
# deployed demo has no way to run the generator.
/public/uploads/*
!/public/uploads/demo/

# authenticated local upload backend (demo/dev only)
/.data/

# k6 summary output — machine-specific numbers, not source
/load/k6/results/*
!/load/k6/results/.gitkeep
test-results/
playwright-report/
e2e/.auth/
coverage/
