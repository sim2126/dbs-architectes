generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  // Roles: admin | director | manager | employee | intern
  // Legacy compat: super_admin | project_manager | viewer | collaborator
  role             String    @default("employee")
  initials         String?
  phone            String?
  isActive         Boolean   @default(true)
  canCreate        Boolean   @default(false)
  canEdit          Boolean   @default(false)
  canDelete        Boolean   @default(false)
  // HR lifecycle
  employmentStatus String    @default("active") // invited | active | on_leave | suspended | terminated
  /// True for guests outside the practice — clients, consultants, contractors.
  /// Guests reach channels through explicit ChannelMember rows and never
  /// through a ProjectAssignment, so they see a conversation and not a
  /// portfolio. They are excluded from staff surfaces: the team directory,
  /// workload, assignee pickers and headcount.
  isExternal       Boolean   @default(false)
  departmentId     String?
  managerId        String?
  defaultCountry   String?   // CH | IT | IN
  defaultRegion    String?
  deactivatedAt    DateTime?
  // Multi-factor authentication. mfaSecret is the TOTP shared secret
  // (base32). mfaEnabledAt is the timestamp when the user completed
  // enrolment — null means MFA is OFF for this user. We store the
  // raw secret because the DB itself is the trust boundary; if it
  // leaks, every MFA factor is compromised anyway, and additional
  // encryption-at-rest is an infra concern (KMS for the volume).
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  projects         ProjectAssignment[]
  agendaItems      AgendaItem[]
  workItems        WorkItem[]
  activities       Activity[]
  channelsCreated  Channel[]           @relation("ChannelCreator")
  channelMembers   ChannelMember[]
  messages         Message[]
  messageReactions MessageReaction[]
  callsStarted     Call[]              @relation("CallStarter")
  callParticipants CallParticipant[]
  googleCalToken   GoogleCalendarToken?
  aiChatSessions   AiChatSession[]
  sheets           Sheet[]
  department       Department?         @relation(fields: [departmentId], references: [id])
  manager          User?               @relation("UserManager", fields: [managerId], references: [id])
  reports          User[]              @relation("UserManager")
  regionAccess     UserRegionAccess[]
  permissionGrants PermissionGrant[]  @relation("PermissionGrantSubject")
  grantsAuthored   PermissionGrant[]  @relation("PermissionGrantAuthor")
  roleChangesFrom  RoleChangeLog[]     @relation("RoleChangeTarget")
  roleChangesBy    RoleChangeLog[]     @relation("RoleChangeActor")
  favorites        Favorite[]
  savedAi          SavedAiResponse[]
  aiAttachments    AiChatAttachment[]
  aiRequestEvents  AiRequestEvent[]
  aiAgentLease     AiAgentLease?
  tasks            Task[]
  invitationsIssued Invitation[]      @relation("InvitationInviter")
  passwordResets    PasswordReset[]
  userSessions      UserSession[]
  statusUpdates     ProjectStatusUpdate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  category        String   @default("Residenziale")
  phase           String   @default("ETUDE/AP")
  client          String?
  year            Int?
  commune         String?
  typology        String?
  terrain         String?
  roof            String?
  description     String?
  pageLink        String?
  image           String?
  floors          Int?
  area            Float?
  status          String   @default("active")
  workStatus      String   @default("todo")
  billing         String?
  notes           String?
  // Regional fields
  country         String?  // CH | IT | IN
  operatingRegion String?  // e.g. "Ticino", "Lombardia", "Maharashtra"
  regionCode      String?  // e.g. "CH-TI", "IT-LOM", "IN-MH"
  sourceSystem    String?
  sourceId        String?
  // Location / map pin
  address         String?  // human-readable address
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments    ProjectAssignment[]
  agendaItems    AgendaItem[]
  workItems      WorkItem[]
  gallery        GalleryImage[]
  floorPlans     FloorPlan[]
  activities     Activity[]
  channels       Channel[]
  calls          Call[]
  importedAssets ImportedAsset[]
  meetingMemory  ProjectMeetingMemory?
  tasks          Task[]
  statusUpdates  ProjectStatusUpdate[]

  @@index([status, updatedAt])
  @@index([phase])
  @@index([country, operatingRegion])
  @@index([commune])
}

// Structured status check-ins authored by project leads/managers.
// Distinct from Channel/Message threads — those are casual chat;
// status updates are the recurring "how is this project doing" pulse
// that surfaces in the PM dashboard and project-health rollups.
model ProjectStatusUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  // "on_track" | "at_risk" | "off_track" — kept as a string to mirror
  // the convention used by phase/workStatus rather than a Prisma enum.
  health    String
  summary   String
  // Optional rolling slots so a lead can post a snapshot without
  // adopting a heavyweight template.
  next      String?
  blockers  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([authorId])
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  role       String?
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// @deprecated Rollback-only during the WorkItem transition. New reads and writes use WorkItem.
model AgendaItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("task")
  priority    String    @default("medium")
  status      String    @default("pending")
  projectId   String?
  userId      String
  color       String?
  allDay      Boolean   @default(false)
  googleEventId String?
  sourceSystem String?
  sourceId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?  @relation(fields: [projectId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([date, status])
  @@index([userId, date])
  @@index([projectId, date])
}

enum WorkItemType {
  task
  meeting
  milestone
  deadline
}

model WorkItem {
  id             String       @id @default(cuid())
  userId         String
  projectId      String?
  parentId       String?
  legacyTaskId   String?      @unique
  legacyAgendaId String?      @unique
  legacyAgendaType String?
  title          String
  description    String?
  type           WorkItemType @default(task)
  startDate      DateTime?
  dueDate        DateTime?
  status         String       @default("todo")
  priority       String       @default("medium")
  position       Float        @default(0)
  completedAt    DateTime?
  color          String?
  allDay         Boolean      @default(false)
  googleEventId  String?
  sourceSystem   String?
  sourceId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   WorkItem?  @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkItem[] @relation("WorkItemHierarchy")

  @@index([userId, status, position])
  @@index([userId, dueDate])
  @@index([userId, startDate])
  @@index([dueDate, status])
  @@index([startDate, status])
  @@index([projectId, dueDate])
  @@index([projectId, startDate])
  @@index([parentId, position])
  @@index([projectId, parentId, position])
  @@unique([userId, sourceSystem, sourceId])
}

model GalleryImage {
  id         String   @id @default(cuid())
  projectId  String?
  title      String?
  url        String
  thumbnail  String?
  type       String   @default("render")
  tags       String?
  colors     String?
  materials  String?
  shapes     String?
  floors     Int?
  year       Int?
  aiAnalysis String?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}

model FloorPlan {
  id           String   @id @default(cuid())
  projectId    String?
  title        String?
  url          String
  type         String   @default("floor_plan")
  floors       Int?
  siteArea     Float?
  buildingArea Float?
  typology     String?
  apartmentMix String?
  shape        String?
  year         Int?
  aiAnalysis   String?
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  projectId   String?
  userId      String
  metadata    String?
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

// ─── CHAT ────────────────────────────────────────────────────

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("public") // public | private | direct
  projectId   String?
  createdBy   String
  sourceSystem String?
  sourceId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project?        @relation(fields: [projectId], references: [id])
  creator  User            @relation("ChannelCreator", fields: [createdBy], references: [id])
  members  ChannelMember[]
  messages Message[]

  @@index([type, createdAt])
  @@unique([projectId, type])
  @@index([createdBy, createdAt])
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  role      String   @default("member") // owner | admin | member
  lastRead  DateTime @default(now())
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId, lastRead])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  userId    String
  content   String
  type      String    @default("text") // text | file | image | system
  fileUrl   String?
  fileName  String?
  parentId  String?
  sourceSystem String?
  sourceId     String?
  importedAt   DateTime?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  channel        Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])
  parent         Message?          @relation("MessageThread", fields: [parentId], references: [id])
  replies        Message[]         @relation("MessageThread")
  reactions      MessageReaction[]
  importedAssets ImportedAsset[]

  @@index([channelId, deletedAt, parentId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
  @@index([createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

// ─── CALLS ───────────────────────────────────────────────────

model Call {
  id        String    @id @default(cuid())
  roomName  String    @unique
  roomUrl   String
  title     String?
  type      String    @default("video") // video | audio
  status    String    @default("active") // active | ended
  startedBy String
  projectId String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  // Post-call artefacts
  recordingUrl   String?
  transcriptId   String?
  transcriptText String?   // cached raw transcript
  summaryMode    String?   // "simple" | "detailed"
  summary        Json?     // full structured summary
  summaryHtml    String?   // rendered markdown for quick display
  shareToken     String?   @unique
  shareExpiresAt DateTime?
  shareRevokedAt DateTime?
  summarizedAt   DateTime?
  summaryError   String?
  detectedLang   String?   // auto-detected transcript language

  starter      User              @relation("CallStarter", fields: [startedBy], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  participants CallParticipant[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([startedBy, createdAt])
  @@index([projectId, createdAt])
  @@index([shareToken, shareExpiresAt])
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([callId, userId])
  @@index([userId])
}

// Rolling condensed knowledge of decisions/risks/open items per project,
// grown after each meeting — consumed as context by future summarizations.
model ProjectMeetingMemory {
  id            String   @id @default(cuid())
  projectId     String   @unique
  condensed     String   // rolling narrative of prior decisions
  openItems     Json?    // unresolved questions/blockers
  keyDecisions  Json?    // canonical decisions with dates
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── AI CHAT ─────────────────────────────────────────────────

model AiChatSession {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId, updatedAt])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ─── SHEETS ──────────────────────────────────────────────────

model ExternalImportRun {
  id          String   @id @default(cuid())
  source      String   // monday
  status      String   // pending | running | completed | failed
  triggeredBy String?
  summary     String?
  errorLog    String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  idMaps ExternalIdMap[]

  @@index([source, status, createdAt])
}

model ExternalIdMap {
  id          String   @id @default(cuid())
  source      String   // monday
  sourceType  String   // board | item | subitem | update | reply | asset | user
  sourceId    String
  targetType  String   // user | project | agenda_item | message | channel | asset
  targetId    String
  importRunId String?
  createdAt   DateTime @default(now())

  importRun ExternalImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([source, sourceType, sourceId])
}

model ImportedAsset {
  id            String   @id @default(cuid())
  source        String   // monday
  sourceAssetId String
  projectId     String?
  messageId     String?
  fileName      String?
  originalUrl   String?
  storedUrl     String?
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([source, sourceAssetId])
  @@index([projectId, createdAt])
  @@index([messageId, createdAt])
}

model Sheet {
  id        String   @id @default(cuid())
  name      String
  columns   String   // JSON: string[]
  rows      String   // JSON: Record<string, string>[]
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ─── GOOGLE CALENDAR ─────────────────────────────────────────

model GoogleCalendarToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── ORGANISATION ─────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  country     String?  // CH | IT | IN — primary country of the department
  description String?
  createdAt   DateTime @default(now())

  users User[]
}

model UserRegionAccess {
  id              String  @id @default(cuid())
  userId          String
  country         String  // CH | IT | IN
  operatingRegion String? // specific sub-region (optional — null means whole country)
  accessLevel     String  // view | manage

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, country, operatingRegion])
  @@index([country, operatingRegion])
}

/// Per-user override of the role-derived permission default.
///
/// Loaded once per request into the authorization Subject, never carried in
/// the JWT — a token-lifetime permission snapshot means a revocation does not
/// take effect until the token expires.
///
/// `effect` is "allow" or "deny". Deny always wins. Allow only applies to
/// actions in OVERRIDABLE_ACTIONS (see platform/authz/authorize.ts): actions
/// with resource-level logic cannot be widened this way, because bypassing
/// their branch would also bypass region and assignment scoping.
model PermissionGrant {
  id     String @id @default(cuid())
  userId String
  /// An Action from platform/authz/actions.ts. Not an enum: the vocabulary
  /// is owned by TypeScript and mirrored to Python, so a DB enum would be a
  /// third place to keep in sync.
  action String
  effect String // allow | deny

  /// Who granted it and why. A permission change without an accountable
  /// author is not auditable.
  grantedById String
  reason      String?

  /// Optional expiry. Grants without one are permanent, which is how a
  /// permission system silently accumulates exceptions — prefer a date.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation("PermissionGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PermissionGrantAuthor", fields: [grantedById], references: [id])

  @@unique([userId, action])
  @@index([userId])
  @@index([expiresAt])
}

model RoleChangeLog {
  id        String   @id @default(cuid())
  userId    String   // the user whose role changed
  changedBy String   // the admin who made the change
  fromRole  String
  toRole    String
  reason    String?
  createdAt DateTime @default(now())

  user    User @relation("RoleChangeTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor   User @relation("RoleChangeActor", fields: [changedBy], references: [id])

  @@index([userId, createdAt])
  @@index([changedBy, createdAt])
}

// ─── AUTHORIZATION LOG ──────────────────────────────────────
// Every authorize() decision is recorded here, allow or deny. The audit
// trail is the source of truth a security team will reach for first;
// see CLAUDE.md / feedback_auth_architecture for the rationale.
//
// Fields are intentionally denormalised:
//   - subjectRole is captured at decision time, so the log stays
//     truthful even if the user's role changes afterwards.
//   - resourceKind + resourceId are nullable for actions with no
//     resource (e.g. "project:create" before the project exists).

model AuthorizationLog {
  id           String   @id @default(cuid())
  subjectId    String
  subjectRole  String
  action       String
  resourceKind String?
  resourceId   String?
  decision     String   // "allow" | "deny"
  reason       String?
  context      String?  // optional JSON: ip, route, requestId, etc.
  createdAt    DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([action, decision, createdAt])
  @@index([resourceKind, resourceId, createdAt])
  @@index([decision, createdAt])
}

// ─── FAVORITES / STARS ──────────────────────────────────────
// Polymorphic per-user favourites: any project, sheet, AI chat session,
// agenda item, or team member can be starred. Resolved on read by the
// API which fans out lookups by entityType.

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // "project" | "sheet" | "agenda" | "user" | "ai_chat"
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ─── SAVED AI RESPONSES ────────────────────────────────────
// Snapshots of Aria assistant responses the user wants to revisit.
// We embed the rendered blocks + plain text so the saved card survives
// even if the original chat session is deleted.

/// A file a user attached in DBS GPT.
///
/// Storage and comprehension are different things. A row here means the file
/// is stored and downloadable; it does NOT mean the assistant can read it.
/// `ingestedAt` is the only signal that content has been extracted and is
/// available to ground an answer — until it is set the UI must say the file is
/// attached but not yet readable, or a user will upload a PDF, ask about it,
/// and get a confident answer from a model that never saw it.
model AiChatAttachment {
  id          String  @id @default(cuid())
  userId      String
  /// Nullable so an attachment survives deletion of the conversation it came
  /// from — same reasoning as SavedAiResponse.sessionId.
  sessionId   String?
  messageId   String?
  filename    String
  contentType String
  sizeBytes   Int
  /// Location from the upload adapter — S3 key or local-disk path depending on
  /// deployment. Never a data URL; large blobs do not belong in Postgres.
  url         String

  /// Text extracted from the file, available to ground an answer.
  ///
  /// Stored on the row rather than chunked into a vector table: a first
  /// pipeline that puts whole documents in context is simpler, verifiable by
  /// reading the column, and correct for the sizes DBS actually attaches.
  /// Chunking and embeddings are the next step, not this one.
  extractedText String?
  /// Number of pages, sheets or rows the extraction covered. Lets the UI say
  /// how much was read rather than implying the whole file was.
  extractedUnits Int?

  /// Set when extraction has run and the text is available to the agent.
  /// Null means stored only.
  ingestedAt  DateTime?
  /// Populated when ingestion fails, so a failure is visible rather than
  /// looking like a file that is processing forever.
  ingestError String?

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@unique([userId, url])
}

model AiRequestEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiAgentLease {
  userId    String   @id
  requestId String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SavedAiResponse {
  id         String   @id @default(cuid())
  userId     String
  // Original chat coordinates — kept for "open in chat" deep-link.
  // Both nullable so a saved snippet survives chat deletion.
  sessionId  String?
  messageId  String?
  title      String   @default("Saved insight")
  text       String   // plain-text fallback rendering
  blocks     Json     // structured Block[] for rich render
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinned, createdAt])
  @@index([userId, createdAt])
}

// ─── PERSONAL TASKS ────────────────────────────────────────
// Rollback-only legacy personal to-dos. New reads and writes use WorkItem.
// `position` is a sparse float (1, 2, 3, 1.5, ...) for cheap drag-reorder
// without renumbering every row.

/// @deprecated Rollback-only during the WorkItem transition. New reads and writes use WorkItem.
model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("todo")     // todo | doing | done
  priority    String   @default("medium")   // low | medium | high | critical
  projectId   String?  // optional link to a Project
  position    Float    @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId, status, position])
  @@index([userId, dueDate])
  @@index([projectId])
}

// ─── INVITATION ────────────────────────────────────────────
// Admin-issued workspace invites. The invitee opens /invite/[token],
// sets their password, and the User row is created on accept.
//
// Token is stored hashed (sha256). We never store the raw token —
// only the URL-bearer sees it. Status flips terminal at accept /
// revoke / expiry; expired rows are pruned by a periodic job (not
// yet implemented — out of scope this phase).
//
// One pending invite per email at a time. Reissuing an invite for an
// already-pending email replaces the prior row (uniqueness enforced
// by application logic, not a DB constraint, so we can keep history
// rows after revoke without conflicts).

model Invitation {
  id           String    @id @default(cuid())
  email        String
  role         String    // role to assign on accept (admin | director | manager | employee | intern)
  tokenHash    String    @unique
  invitedBy    String    // userId of the admin who issued
  /// Set when inviting an address outside the workspace domain. Recorded on
  /// the invitation rather than re-derived at accept time: the admin's
  /// decision is the source of truth, and a domain check at acceptance
  /// could silently reclassify someone.
  isExternal   Boolean   @default(false)
  expiresAt    DateTime
  status       String    @default("pending") // pending | accepted | revoked | expired
  acceptedAt   DateTime?
  acceptedUserId String? // populated when accepted; points at the resulting User
  createdAt    DateTime  @default(now())

  inviter User @relation("InvitationInviter", fields: [invitedBy], references: [id])
  // acceptedUser left unrelated — the User row is created on accept and
  // the link is informational only.

  @@index([email, status])
  @@index([status, expiresAt])
}

// ─── PASSWORD RESET ────────────────────────────────────────
// Single-use, expiring tokens for forgot-password flow.
//
// Same hashing pattern as Invitation: only tokenHash is stored. A
// successful reset marks the row used and invalidates other active
// sessions of the user (handled in the route, not the schema).

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

// ─── USER SESSION ──────────────────────────────────────────
// Per-issued-JWT row. NextAuth uses JWT strategy (stateless cookie),
// so to support "active sessions / revoke per device" we record one
// row per sign-in. The JWT carries the row id; on every gated
// request loadSubject() looks the row up, refuses if revokedAt is
// set, and updates lastSeenAt (throttled to ~once per 5 min to
// avoid hammering the DB).
//
// ip + userAgent are captured at sign-in for the "active sessions"
// list display. They're informational — we don't pin sessions to
// these values (legit users move networks).

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  ip         String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, lastSeenAt])
}
